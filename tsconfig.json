{
  // Read by `npm run typecheck` (scripts/typecheck.mjs) only; TypeScript accepts comments here.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.mjs", "scripts/**/*.mjs", "tests/**/*.mjs"]
}
