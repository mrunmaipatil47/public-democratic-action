{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrunmaipatil47/public-democratic-action/schema/pack.schema.json",
  "title": "Pack metadata",
  "description": "Front matter of the discussion pack Public Voice Between Elections: title, version, date, disclaimer, working context, AI-assisted notice, source document and the counts that the other data files must match. The pack is a proposal, not an endorsed movement platform.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "subtitle",
    "tagline",
    "version",
    "dateText",
    "date",
    "purpose",
    "disclaimer",
    "workingContext",
    "aiAssistedNotice",
    "sourceDocument",
    "counts",
    "appendices"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$"
    },
    "dateText": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "workingContext": {
      "type": [
        "string",
        "null"
      ]
    },
    "aiAssistedNotice": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceDocument": {
      "type": "string",
      "pattern": "^https://"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues",
        "domains",
        "routes",
        "organisations",
        "sources"
      ],
      "properties": {
        "issues": {
          "type": "integer",
          "minimum": 0
        },
        "domains": {
          "type": "integer",
          "minimum": 0
        },
        "routes": {
          "type": "integer",
          "minimum": 0
        },
        "organisations": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "appendices": {
      "type": "object",
      "description": "Appendix titles and the Appendix A introduction, quoted from the pack. The Appendix A intro carries the caveat that owners are indicative and that no listed evidence is asserted to have been collected.",
      "additionalProperties": false,
      "required": [
        "A",
        "B",
        "C"
      ],
      "properties": {
        "A": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "intro"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "intro": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "B": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "C": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
