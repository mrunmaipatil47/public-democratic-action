{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrunmaipatil47/public-democratic-action/schema/domains.schema.json",
  "title": "Issue domains",
  "description": "The ten domains that group the 100 issue families in Appendix A (001-010 Democracy, public voice and media, through 091-100 Digital rights, finance and long-term public capacity). Each domain lists its inclusive id range and the issue ids inside it.",
  "type": "array",
  "minItems": 10,
  "maxItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "slug", "name", "range", "issueIds"],
    "properties": {
      "id": { "type": "string", "pattern": "^d\\d{2}$" },
      "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1 },
      "range": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string", "pattern": "^\\d{3}$" }
      },
      "issueIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^\\d{3}$" }
      }
    }
  }
}
